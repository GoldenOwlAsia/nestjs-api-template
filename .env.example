NODE_ENV=development
PORT=3000

# Postgres (docker compose uses these to create the database too)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nestjs_api
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Cache + BullMQ queues (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Comma-separated allowed origins; unset = allow all
# CORS_ORIGIN=http://localhost:5173

# Error tracking: unset = Sentry disabled. Traces: 0 = off, 0.1 = sample 10%.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0
